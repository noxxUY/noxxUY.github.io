---
import '../styles/global.css'
import { Font } from 'astro:assets'
import { profile, displayName } from '../data/profile'
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{displayName}</title>
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body>
    <div class="card">
      <svg class="mark" viewBox="0 0 32 32" width="92" height="92" fill="none" aria-hidden="true">
        <path d="M22.5 24.5 29.2 14.3" stroke="#e8470f" stroke-width="4.5"></path>
        <path
          d="M3 26V14L5.6 8.4L8.4 12.5L9.8 12.1L12.3 7.6L14 13.4C15 16 16.4 16.9 18.4 16.9C22.6 16.9 26.4 19.6 27.2 26Z"
          fill="#111113"></path>
      </svg>
      <div>
        <p class="name">{displayName}</p>
        <p class="role">{profile.role.en}. TypeScript, React and WebGL in the browser; C++ and reverse engineering underneath.</p>
      </div>
      <p class="url">{profile.links.site.replace('https://', '')}</p>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #ffffff;
    color: #111113;
  }
  .card {
    box-sizing: border-box;
    height: 630px;
    padding: 72px 88px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mark {
    display: block;
  }
  .name {
    font-size: 132px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .role {
    max-width: 900px;
    margin-top: 28px;
    font-size: 34px;
    font-weight: 500;
    line-height: 1.3;
    color: #64656d;
  }
  .url {
    font-family: var(--font-jetbrains-mono);
    font-size: 26px;
    color: #64656d;
  }
</style>
