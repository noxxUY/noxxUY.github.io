---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { profile, type L } from '../data/profile'
import { t as translate, type Locale } from '../i18n/ui'
import T from './T.astro'
import LangSwitch from './LangSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  path?: string
  sections?: { id: string; label: L }[]
  inPlaceLang?: boolean
}

const { locale, path = '', sections, inPlaceLang = false } = Astro.props
const t = translate(locale)
---

<header class="top no-print">
  <a class="brand" href={getRelativeLocaleUrl(locale, '')} aria-label={`${profile.alias}, ${t('brand.home')}`}>
    <svg class="cat" viewBox="0 0 32 32" width="26" height="26" fill="none" aria-hidden="true">
      <path class="tail" d="M22.5 24.5 29.2 14.3" pathLength="1" stroke="var(--accent)" stroke-width="4.5"></path>
      <path
        class="body"
        d="M3 26V14L5.6 8.4L8.4 12.5L9.8 12.1L12.3 7.6L14 13.4C15 16 16.4 16.9 18.4 16.9C22.6 16.9 26.4 19.6 27.2 26Z"
        fill="currentColor"></path>
    </svg>
    <span class="name">{profile.alias}</span>
  </a>

  {
    sections && (
      <nav class="marks" aria-label={t('nav.sections')}>
        {sections.map((s) => (
          <a class="mark" href={`#${s.id}`} data-section-link={s.id}>
            <span class="label">
              <T text={s.label} />
            </span>
          </a>
        ))}
      </nav>
    )
  }

  <div class="controls">
    <LangSwitch locale={locale} path={path} inPlace={inPlaceLang} />
    <ThemeToggle locale={locale} />
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    background: var(--bg);
    font-family: var(--font-mono);
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-inline: var(--pad);
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.059rem;
    letter-spacing: -0.02em;
  }
  .cat {
    display: block;
    overflow: visible;
    transition: color 160ms ease;
  }
  .brand:hover .cat {
    color: var(--accent);
  }
  .tail {
    transform-box: view-box;
    transform-origin: 22.5px 24.5px;
    transition: transform 260ms var(--ease);
  }
  .brand:hover .tail {
    transform: rotate(-18deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tail {
      stroke-dasharray: 1;
      animation: draw-tail 420ms var(--ease) 90ms backwards;
    }
    @keyframes draw-tail {
      from {
        stroke-dashoffset: 1;
      }
    }
  }

  .marks {
    display: none;
    margin-left: auto;
  }
  @media (min-width: 900px) {
    .marks {
      display: flex;
    }
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 12px;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--muted);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }
  .mark:hover,
  .mark.is-on {
    color: var(--text);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    padding-inline: var(--pad);
  }
  .marks + .controls {
    margin-left: 0;
  }

  @media (max-width: 899px) {
    .controls {
      gap: 6px;
    }
  }
  @media (max-width: 479px) {
    .top {
      --pad: 13px;
    }
    .brand {
      gap: 8px;
      font-size: 1rem;
    }
    .cat {
      width: 22px;
      height: 22px;
    }
  }
</style>
