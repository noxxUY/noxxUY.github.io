---
import { profile } from '../data/profile'
import { both, t as translate, type Locale } from '../i18n/ui'
import T from './T.astro'

interface Props {
  locale: Locale
  bilingual?: boolean
}

const { locale, bilingual = false } = Astro.props
const t = translate(locale)
const year = new Date().getFullYear()
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/+$/, '')
---

<footer class="site-footer no-print">
  <div class="row">
    <p class="who">
      <span class="c">©</span>
      <span>{year} {profile.alias} &middot; {bilingual ? <T text={profile.role} /> : profile.role[locale]}</span>
    </p>

    <a class="link" href={profile.links.github}>
      <svg class="gh" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      <span class="mono">{bare(profile.links.github)}</span>
    </a>

    <a class="link" href={profile.links.siteSource}>
      <span class="arrow" aria-hidden="true">↗</span>
      <span>{bilingual ? <T text={both('footer.source')} /> : t('footer.source')}</span>
    </a>

    <p class="eof mono" aria-hidden="true">EOF</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    transition: border-color 220ms ease;
  }
  .row {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 28px;
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    padding: 16px var(--pad);
    border-inline: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }
  .c {
    color: var(--faint);
  }
  .mono {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }
  .link:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .gh,
  .arrow {
    flex: none;
    color: var(--faint);
    transition: color 160ms ease;
  }
  .link:hover .gh,
  .link:hover .arrow {
    color: var(--accent-text);
  }
  .eof {
    margin-left: auto;
    color: var(--faint);
    letter-spacing: 0.14em;
  }
  @media (max-width: 639px) {
    .eof {
      display: none;
    }
  }
</style>
