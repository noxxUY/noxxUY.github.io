---
import { t as translate, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const t = translate(Astro.props.locale)
---

<button
  class="ctl toggle"
  type="button"
  data-theme-toggle
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
>
  <span class="icon" aria-hidden="true">
    <svg
      class="sun"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      stroke-linejoin="miter"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"></path>
    </svg>
    <svg
      class="moon"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      stroke-linejoin="miter"
    >
      <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5z"></path>
    </svg>
  </span>
</button>

<style>
  .toggle {
    width: 32px;
    padding: 0;
  }
  .icon {
    display: grid;
    place-items: center;
  }
  .moon {
    display: none;
  }
  :global(html[data-theme='dark']) .moon {
    display: block;
  }
  :global(html[data-theme='dark']) .sun {
    display: none;
  }
</style>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

  const KEY = 'noxx-portfolio-theme'
  type Theme = 'light' | 'dark'

  const current = (): Theme => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light')

  function label(button: HTMLElement, theme: Theme) {
    const next = theme === 'dark' ? button.dataset.labelLight : button.dataset.labelDark
    if (next) button.setAttribute('aria-label', next)
  }

  function apply(theme: Theme) {
    document.documentElement.dataset.theme = theme
    try {
      localStorage.setItem(KEY, theme)
    } catch {
    }
    for (const b of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) label(b, theme)
  }

  document.addEventListener('astro:before-swap', (e) => {
    ;(e as TransitionBeforeSwapEvent).newDocument.documentElement.dataset.theme = current()
  })

  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
      label(button, current())
      button.addEventListener('click', () => {
        apply(current() === 'dark' ? 'light' : 'dark')
        const icon = button.querySelector<HTMLElement>('.icon')
        if (icon) {
          icon.classList.remove('anim-scale-in')
          void icon.offsetWidth
          icon.classList.add('anim-scale-in')
        }
      })
    }
  })
</script>
