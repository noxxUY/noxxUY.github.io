---
import '../styles/home.css'
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import Base from '../layouts/Base.astro'
import T from './T.astro'
import { profile, displayName, cvFile, skillText } from '../data/profile'
import { both, t as translate, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translate(locale)

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', { eager: true })
const shotFor = (file?: string) => (file ? shots[`../assets/projects/${file}`]?.default : undefined)
const lightShotFor = (file?: string) => shotFor(file?.replace(/\.(png|jpe?g|webp)$/, '-light.$1'))

const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/?#.*$/, '').replace(/\/+$/, '')

const sections = [
  { id: 'work', label: both('nav.work') },
  { id: 'stack', label: both('nav.stack') },
  { id: 'contact', label: both('nav.contact') },
]

const heroStrings = JSON.stringify({ tris: both('hero.tris') })
---

<Base
  locale={locale}
  title={t('meta.title')}
  description={t('meta.description')}
  sections={sections}
  bilingual
  titles={both('meta.title')}
>
  <div class="page">
    <section class="hero" aria-labelledby="name">
      <div class="hero-text">
        <h1 class="display anim-fade-up" id="name">{displayName}</h1>
        <p class="where anim-fade-up delay-1">
          <T text={profile.role} /> &middot; <T text={profile.location} />
        </p>
        <p class="deck anim-fade-up delay-1"><T text={profile.roleLine} /></p>
        <p class="lede anim-fade-up delay-2"><T text={profile.summary} /></p>
        <p class="acts anim-fade-up delay-3">
          <a class="btn btn-solid" href={profile.links.github}>GitHub</a>
          <a
            class="btn"
            href={getRelativeLocaleUrl(locale, 'cv')}
            data-swap
            data-href-en={getRelativeLocaleUrl('en', 'cv')}
            data-href-es={getRelativeLocaleUrl('es', 'cv')}
          >
            <T text={both('hero.cvOnline')} />
          </a>
        </p>
      </div>

      <figure class="slot anim-fade-up delay-2" data-hero data-state="idle" data-strings={heroStrings}>
        <canvas class="slot-canvas" aria-hidden="true"></canvas>
        <figcaption class="slot-status" data-hero-status aria-live="polite">
          <T text={both('hero.placeholder')} />
        </figcaption>
      </figure>
    </section>

    <section id="work" class="sec" data-section aria-labelledby="work-title">
      <h2 class="sec-title" id="work-title"><T text={both('nav.work')} /></h2>

      <ul class="projects">
        {
          profile.projects.map((p, i) => {
            const shot = shotFor(p.image)
            const lightShot = lightShotFor(p.image)
            const alt = p.imageAlt ?? { en: p.name, es: p.name }
            const href = p.live ?? p.source
            return (
              <li class="project" data-reveal>
                {shot && (
                  <a class="shot-link" href={href} tabindex="-1" aria-hidden="true">
                    {lightShot && (
                      <Picture
                        class="shot shot-light"
                        src={lightShot}
                        formats={['avif', 'webp']}
                        widths={[400, 640, 800]}
                        sizes="(min-width: 760px) 300px, 100vw"
                        alt=""
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    )}
                    <Picture
                      class={lightShot ? 'shot shot-dark' : 'shot'}
                      src={shot}
                      formats={['avif', 'webp']}
                      widths={[400, 640, 800]}
                      sizes="(min-width: 760px) 300px, 100vw"
                      alt={alt[locale]}
                      data-swap
                      data-alt-en={alt.en}
                      data-alt-es={alt.es}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </a>
                )}
                <div class="project-body">
                  <div class="project-head">
                    <h3 class="project-name">
                      <a href={href}>{p.name}</a>
                    </h3>
                    <span class="project-date">
                      <T text={p.date} />
                    </span>
                  </div>
                  <p class="project-tag">
                    <T text={p.tagline} />
                  </p>
                  <p class="project-desc">
                    <T text={p.description} />
                  </p>
                  <p class="project-stack">{p.stack.join(' · ')}</p>
                  <p class="project-links">
                    {p.live && (
                      <a href={p.live}>
                        {bare(p.live)} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    {p.source && (
                      <a href={p.source}>
                        <T text={both('projects.source')} /> <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </p>
                </div>
              </li>
            )
          })
        }
      </ul>
    </section>

    <section id="stack" class="sec" data-section aria-labelledby="stack-title">
      <h2 class="sec-title" id="stack-title"><T text={both('nav.stack')} /></h2>
      <dl class="rows">
        {
          profile.skills.map((g) => (
            <div class="row" data-reveal>
              <dt>
                <T text={g.group} />
              </dt>
              <dd>
                {g.items.map((it, i) => (
                  <>
                    {i > 0 && <span class="sep"> · </span>}
                    <T text={skillText(it)} />
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="contact" class="sec" data-section aria-labelledby="contact-title">
      <h2 class="sec-title" id="contact-title"><T text={both('nav.contact')} /></h2>
      <p class="cta"><T text={profile.availability} /></p>
      <dl class="rows">
        {
          profile.email && (
            <div class="row">
              <dt>
                <T text={both('contact.email')} />
              </dt>
              <dd>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </dd>
            </div>
          )
        }
        <div class="row">
          <dt>GitHub</dt>
          <dd><a href={profile.links.github}>{bare(profile.links.github)}</a></dd>
        </div>
        {
          profile.links.linkedin && (
            <div class="row">
              <dt>LinkedIn</dt>
              <dd>
                <a href={profile.links.linkedin}>{bare(profile.links.linkedin)}</a>
              </dd>
            </div>
          )
        }
        <div class="row">
          <dt><T text={both('contact.cv')} /></dt>
          <dd class="cv-links">
            <a
              href={getRelativeLocaleUrl(locale, 'cv')}
              data-swap
              data-href-en={getRelativeLocaleUrl('en', 'cv')}
              data-href-es={getRelativeLocaleUrl('es', 'cv')}
            >
              <T text={both('contact.cvOnline')} />
            </a>
            <a href={cvFile('en')} download><T text={both('contact.cvEn')} /></a>
            <a href={cvFile('es')} download><T text={both('contact.cvEs')} /></a>
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  import { initHome, destroyHome } from '../lib/home'
  import { initLang, destroyLang } from '../lib/lang'
  import { initHero, destroyHero } from '../lib/hero'

  document.addEventListener('astro:page-load', () => {
    initLang()
    initHome()
    initHero()
  })
  document.addEventListener('astro:before-swap', () => {
    destroyLang()
    destroyHome()
    destroyHero()
  })
</script>
