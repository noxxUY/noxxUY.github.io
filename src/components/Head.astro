---
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import { profile, displayName, skillText } from '../data/profile'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  title: string
  description: string
  path?: string
  noindex?: boolean
}

const { locale, title, description, path = '', noindex = false } = Astro.props
const en = getAbsoluteLocaleUrl('en', path)
const es = getAbsoluteLocaleUrl('es', path)
const canonical = locale === 'es' ? es : en
const ogImage = new URL('/og.png', Astro.site).href

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  ...(profile.fullName ? { alternateName: profile.alias } : {}),
  jobTitle: profile.role[locale],
  description: profile.summary[locale],
  url: profile.links.site,
  image: ogImage,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
  ...(profile.email ? { email: `mailto:${profile.email}` } : {}),
  address: { '@type': 'PostalAddress', addressCountry: profile.countryCode },
  knowsAbout: profile.skills.flatMap((g) => g.items.map((i) => skillText(i)[locale])),
}
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{
  !noindex && (
    <>
      <link rel="alternate" hreflang="en" href={en} />
      <link rel="alternate" hreflang="es" href={es} />
      <link rel="alternate" hreflang="x-default" href={en} />
    </>
  )
}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={displayName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'es' ? 'es_UY' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_UY'} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
